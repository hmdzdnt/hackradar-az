# Frontend: public API URL only; never put secrets in VITE_* variables.
# Leave empty to preview the checked-in, live-source verified snapshot.
VITE_API_BASE_URL=

# Python discovery / GitHub Actions secrets (never frontend variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Worker secrets (wrangler secret put NAME or worker/.dev.vars locally)
SUPABASE_ANON_KEY=
RATE_LIMIT_SALT=
GEMINI_API_KEY=

# Worker non-secret settings live in worker/wrangler.toml
# ALLOWED_ORIGIN=https://hackradar-az.pages.dev
# GEMINI_ENABLED=false
# GEMINI_MODEL=gemini-2.5-flash-lite
